# API — configuration exigée au démarrage.
# Le serveur refuse de démarrer si l'une manque : échouer à la première requête
# coûte plus cher que refuser de démarrer.

# N'importe quel PostgreSQL 18 convient : celui de `docker compose up` (5442 côté hôte,
# voir docker-compose.yml) ou une base hébergée. La valeur ci-dessous est la première ;
# rien ne la devine à votre place, et le banc d'essai refuse de tourner sans elle.
DATABASE_URL=postgres://neftya:neftya@localhost:5442/neftya

# **Base hébergée : prendre le point d'accès direct, pas le pooler.** Le banc d'essai
# isole chaque fichier de test dans son propre schéma, qu'il passe en paramètre de
# démarrage (`options=-c search_path=...`). Un pooler rejette ce paramètre, et toute la
# suite tombe — sur Neon, c'est l'URL sans `-pooler` dans le nom d'hôte.
#
# `sslmode=verify-full` plutôt que `require` : `pg` traite aujourd'hui les deux pareil,
# et changera d'avis au profit du moins sûr.

# Le secret qui signe les jetons d'accès locaux. **Exigée** : le serveur refuse de
# démarrer sans elle, ou si elle fait moins de 32 caractères.
#
# À tirer au hasard, une fois par installation :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# La changer invalide toutes les sessions en cours — c'est aussi le moyen de les révoquer
# toutes d'un coup.
NEFTYA_JWT_SECRET=

PORT=3000
HOST=0.0.0.0

# Identité locale — voir docs/AUTH_LOCAL.md.
#
# Secret HS256 des jetons d'accès. 32 caractères au moins : le serveur refuse
# de démarrer sinon. À générer avec `openssl rand -hex 32`.
# NEFTYA_JWT_SECRET=

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Vide : aucune. Une liste oubliée doit empêcher l'interface de fonctionner, pas ouvrir
# l'API à tout le monde.
NEFTYA_ALLOWED_ORIGINS=http://localhost:5173

# L'assistant : un modèle direct — voir docs/AI_LOCAL.md.
#
# Sans OPENAI_API_KEY, l'assistant répond qu'il n'est pas configuré. Toute API
# compatible OpenAI convient (relais local compris). Le modèle nommé ici est
# ce qu'on paie à chaque appel : le changer ne demande aucun déploiement de contrat.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# Profondeur de réflexion des modèles à raisonnement (`minimal`…`xhigh`).
# Vide : champ omis, pour les relais qui rejetteraient un paramètre inconnu.
OPENAI_REASONING_EFFORT=minimal

# Repli Sekuu AI (inactif tant que la plateforme l'est) : utilisé seulement
# sans OPENAI_API_KEY. Clé portant `ai.run.delegated`, tâches `extract`.
SEKUU_AI_URL=https://ai.sekuu.com
# SEKUU_AI_API_KEY=

# Envoi des devis — voir docs/OPERATIONS.md §2.
#
# N'importe quel SMTP convient (prestataire ou relais local). Sans
# NEFTYA_SMTP_HOST, la route rend 503 : un devis non envoyé n'est pas perdu,
# il s'enregistre et se renvoie.
# NEFTYA_SMTP_HOST=
# NEFTYA_SMTP_PORT=587
# NEFTYA_SMTP_SECURE=false
# NEFTYA_SMTP_USER=
# NEFTYA_SMTP_PASSWORD=
# NEFTYA_SMTP_FROM=

# Envoi des devis au client de l'artisan. Sans `NEFTYA_SMTP_HOST`, la route répond 503 :
# un devis non envoyé n'est pas un devis perdu, et rien n'est tenté.
# NEFTYA_SMTP_HOST=
NEFTYA_SMTP_PORT=587
NEFTYA_SMTP_SECURE=false
# Exigées dès que l'hôte est renseigné.
# NEFTYA_SMTP_USER=
# NEFTYA_SMTP_PASSWORD=
# L'expéditeur affiché. À défaut, `NEFTYA_SMTP_USER`.
# NEFTYA_SMTP_FROM=

# Sekuu Platform — **facultatif**. Sans `SEKUU_JWKS_URL`, seuls les jetons locaux sont
# reconnus, et l'API démarre sans aucune de ces variables.
# Sekuu Platform — voir docs/SEKUU.md
SEKUU_PLATFORM_URL=https://platform.sekuu.com
SEKUU_JWKS_URL=https://platform.sekuu.com/.well-known/jwks.json
SEKUU_ISSUER=https://identity.sekuu.com
SEKUU_AUDIENCE=sekuu-platform
SEKUU_PRODUCT_SLUG=neftya

# Clé d'API Storage, pour déposer les exports. Absente, les exports sont produits et
# enregistrés sans être déposés : personne n'a de clé en local.
# Émise avec `storage.write.delegated` et --types=neftya.export, rien de plus.
SEKUU_STORAGE_URL=https://storage.sekuu.com
SEKUU_STORAGE_API_KEY=

# Fichiers déposés localement — voir docs/OPERATIONS.md §5. Avec une clé
# SEKUU_STORAGE_API_KEY, le dépôt repart chez Sekuu et ce répertoire ne sert plus.
NEFTYA_DATA_DIR=./data

# Facturation — Stripe
#
# **Les deux vont ensemble.** Avec la clé seule, un paiement est encaissé sans que rien ne
# l'apprenne : le client est débité et reste sans accès. Le serveur refuse donc de démarrer
# si l'une manque. Absentes toutes les deux, aucun encaisseur n'est enregistré et l'API sert
# le gratuit sans rien proposer d'autre — ce qui est le bon défaut pour une installation qui
# ne vend pas.
#
# Le secret du webhook n'est pas la clé d'API : il est propre au point de terminaison, et se
# lit dans le tableau de bord Stripe à sa création. En local, `stripe listen` en imprime un.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# L'adresse de l'interface, où le client revient après avoir payé.
# Absente, le retour tombe sur le serveur de développement : visible tout de suite en local,
# invisible en production.
NEFTYA_APP_URL=http://localhost:5174

# Facturation — les prix, en unité mineure
#
# Une variable par offre, devise et période : NEFTYA_PRICE_<OFFRE>_<DEVISE>_<PÉRIODE>.
# Les offres sont `pro` et `professional` ; les devises `EUR` et `XAF` ; les périodes
# `MONTHLY` et `YEARLY`.
#
# **Unité mineure, sans séparateur.** 29 € s'écrit 2900. Le franc CFA n'a pas de décimale :
# 19 000 F s'écrit 19000. Écrire `29` au lieu de `2900` encaisserait vingt-neuf centimes par
# mois, et rien ne le montrerait avant le relevé bancaire — le serveur refuse donc de
# démarrer sous 100 en unité mineure, et sur toute valeur qui n'est pas une suite de chiffres.
#
# **Une variable absente retire l'offre de la vente dans cette combinaison.** C'est une
# réponse, pas un oubli : tant qu'un prix en francs CFA n'est pas arrêté, le mobile money ne
# propose pas cette offre. On ne convertit pas au taux du jour.
NEFTYA_PRICE_PRO_EUR_MONTHLY=2900
NEFTYA_PRICE_PROFESSIONAL_EUR_MONTHLY=7900
# NEFTYA_PRICE_PRO_EUR_YEARLY=
# NEFTYA_PRICE_PRO_XAF_MONTHLY=
# NEFTYA_PRICE_PRO_XAF_YEARLY=
# NEFTYA_PRICE_PROFESSIONAL_EUR_YEARLY=
# NEFTYA_PRICE_PROFESSIONAL_XAF_MONTHLY=
# NEFTYA_PRICE_PROFESSIONAL_XAF_YEARLY=

# Web
VITE_API_URL=http://localhost:3000
VITE_SEKUU_PORTAL_URL=https://platform.sekuu.com

# L'adresse publique du site, sans barre finale.
#
# Elle porte les cinq URL absolues de la page d'accueil : le canonical, `og:url`,
# `og:image`, le `Sitemap:` de robots.txt et le `<loc>` du plan du site. Une adresse fausse
# ne se voit pas sur l'écran de celui qui déploie — un canonical qui pointe ailleurs dit aux
# moteurs que la vraie page est ailleurs, et une image de partage absolue qui n'existe pas
# rend un lien sans aperçu. Les deux se découvrent des semaines plus tard.
#
# **Absente, `vite build` refuse de construire.** En développement, `localhost:5174` suffit
# et la variable peut rester vide.
VITE_SITE_URL=http://localhost:5174
