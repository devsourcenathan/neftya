# API — configuration exigée au démarrage.
# Le serveur refuse de démarrer si l'une manque : échouer à la première requête
# coûte plus cher que refuser de démarrer.

# N'importe quel PostgreSQL 18 convient : celui de `docker compose up` (5442 côté hôte,
# voir docker-compose.yml) ou une base hébergée. La valeur ci-dessous est la première ;
# rien ne la devine à votre place, et le banc d'essai refuse de tourner sans elle.
DATABASE_URL=postgres://neftya:neftya@localhost:5442/neftya

# **Base hébergée : prendre le point d'accès direct, pas le pooler.** Le banc d'essai
# isole chaque fichier de test dans son propre schéma, qu'il passe en paramètre de
# démarrage (`options=-c search_path=...`). Un pooler rejette ce paramètre, et toute la
# suite tombe — sur Neon, c'est l'URL sans `-pooler` dans le nom d'hôte.
#
# `sslmode=verify-full` plutôt que `require` : `pg` traite aujourd'hui les deux pareil,
# et changera d'avis au profit du moins sûr.

PORT=3000
HOST=0.0.0.0

# Identité locale — voir docs/AUTH_LOCAL.md.
#
# Secret HS256 des jetons d'accès. 32 caractères au moins : le serveur refuse
# de démarrer sinon. À générer avec `openssl rand -hex 32`.
# NEFTYA_JWT_SECRET=

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Vide : aucune. Une liste oubliée doit empêcher l'interface de fonctionner, pas ouvrir
# l'API à tout le monde.
NEFTYA_ALLOWED_ORIGINS=http://localhost:5173

# L'assistant : un modèle direct — voir docs/AI_LOCAL.md.
#
# Sans OPENAI_API_KEY, l'assistant répond qu'il n'est pas configuré. Toute API
# compatible OpenAI convient (relais local compris). Le modèle nommé ici est
# ce qu'on paie à chaque appel : le changer ne demande aucun déploiement de contrat.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Repli Sekuu AI (inactif tant que la plateforme l'est) : utilisé seulement
# sans OPENAI_API_KEY. Clé portant `ai.run.delegated`, tâches `extract`.
SEKUU_AI_URL=https://ai.sekuu.com
# SEKUU_AI_API_KEY=

# Sekuu Platform — voir docs/SEKUU.md
SEKUU_PLATFORM_URL=https://platform.sekuu.com
SEKUU_JWKS_URL=https://platform.sekuu.com/.well-known/jwks.json
SEKUU_ISSUER=https://identity.sekuu.com
SEKUU_AUDIENCE=sekuu-platform
SEKUU_PRODUCT_SLUG=neftya

# Clé d'API Storage, pour déposer les exports. Absente, les exports sont produits et
# enregistrés sans être déposés : personne n'a de clé en local.
# Émise avec `storage.write.delegated` et --types=neftya.export, rien de plus.
SEKUU_STORAGE_URL=https://storage.sekuu.com
SEKUU_STORAGE_API_KEY=

# Fichiers déposés localement — voir docs/OPERATIONS.md §5. Avec une clé
# SEKUU_STORAGE_API_KEY, le dépôt repart chez Sekuu et ce répertoire ne sert plus.
NEFTYA_DATA_DIR=./data

# Web
VITE_API_URL=http://localhost:3000
VITE_SEKUU_PORTAL_URL=https://platform.sekuu.com
