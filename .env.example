# API — configuration exigée au démarrage.
# Le serveur refuse de démarrer si l'une manque : échouer à la première requête
# coûte plus cher que refuser de démarrer.

# Ce que `docker compose up` expose (5442 côté hôte, voir docker-compose.yml).
DATABASE_URL=postgres://neftya:neftya@localhost:5442/neftya

PORT=3000
HOST=0.0.0.0

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Vide : aucune. Une liste oubliée doit empêcher l'interface de fonctionner, pas ouvrir
# l'API à tout le monde.
NEFTYA_ALLOWED_ORIGINS=http://localhost:5173

# Sekuu Platform — voir docs/SEKUU.md
SEKUU_PLATFORM_URL=https://platform.sekuu.com
SEKUU_JWKS_URL=https://platform.sekuu.com/.well-known/jwks.json
SEKUU_ISSUER=https://identity.sekuu.com
SEKUU_AUDIENCE=sekuu-platform
SEKUU_PRODUCT_SLUG=neftya

# Clé d'API Storage, pour déposer les exports. Absente, les exports sont produits et
# enregistrés sans être déposés : personne n'a de clé en local.
# Émise avec `storage.write.delegated` et --types=neftya.export, rien de plus.
SEKUU_STORAGE_URL=https://storage.sekuu.com
SEKUU_STORAGE_API_KEY=

# Web
VITE_API_URL=http://localhost:3000
VITE_SEKUU_PORTAL_URL=https://platform.sekuu.com
