{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist-types",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/test-support/**/*"],
  "references": [
    {
      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/drawing"
    },
    {
      "path": "../../packages/units"
    }
  ]
}
